  "schema_reference": "CANN_API official schema; PYTORCH_API absent, PRAGMA fallback",
  "queries": {
    "scopes": "WITH scopes AS (\n SELECT n.value AS scope,CAST(p.startNs AS INTEGER) AS s,CAST(p.endNs AS INTEGER) AS e\n FROM PYTORCH_API p JOIN STRING_IDS n ON n.id=p.name\n WHERE n.value LIKE 'diagnosis/%/3/%'\n)\nSELECT scope,COUNT(*) AS calls,SUM(e-s)/1e9 AS host_seconds FROM scopes GROUP BY scope ORDER BY scope LIMIT 20",
    "first_engine_cann": "WITH scopes AS (\n SELECT n.value AS scope,CAST(p.startNs AS INTEGER) AS s,CAST(p.endNs AS INTEGER) AS e\n FROM PYTORCH_API p JOIN STRING_IDS n ON n.id=p.name\n WHERE n.value LIKE 'diagnosis/%/3/%'\n)\nSELECT n.value AS name,COUNT(*) AS calls,SUM(MIN(a.endNs,s.e)-MAX(a.startNs,s.s))/1e9 AS clipped_host_seconds,MAX(a.endNs-a.startNs)/1e9 AS longest_full_call_seconds FROM scopes s JOIN CANN_API a ON a.startNs<s.e AND a.endNs>s.s JOIN STRING_IDS n ON n.id=a.name WHERE s.scope='diagnosis/engine_forward/3/1' GROUP BY n.value ORDER BY clipped_host_seconds DESC LIMIT 20",
    "allocator_calls": "SELECT n.value AS name,COUNT(*) AS calls,SUM(a.endNs-a.startNs)/1e9 AS host_seconds,MAX(a.endNs-a.startNs)/1e9 AS longest_seconds FROM CANN_API a JOIN STRING_IDS n ON n.id=a.name WHERE n.value LIKE '%Malloc%' OR n.value LIKE '%Free%' OR n.value LIKE '%MemMap%' OR n.value LIKE '%MemUnmap%' GROUP BY n.value ORDER BY host_seconds DESC LIMIT 20",
    "first_engine_pytorch": "WITH scopes AS (\n SELECT n.value AS scope,CAST(p.startNs AS INTEGER) AS s,CAST(p.endNs AS INTEGER) AS e\n FROM PYTORCH_API p JOIN STRING_IDS n ON n.id=p.name\n WHERE n.value LIKE 'diagnosis/%/3/%'\n)\nSELECT n.value AS name,COUNT(*) AS calls,SUM(MIN(CAST(a.endNs AS INTEGER),s.e)-MAX(CAST(a.startNs AS INTEGER),s.s))/1e9 AS clipped_inclusive_host_seconds FROM scopes s JOIN PYTORCH_API a ON CAST(a.startNs AS INTEGER)<s.e AND CAST(a.endNs AS INTEGER)>s.s JOIN STRING_IDS n ON n.id=a.name WHERE s.scope='diagnosis/engine_forward/3/1' AND n.value NOT LIKE 'diagnosis/%' GROUP BY n.value ORDER BY clipped_inclusive_host_seconds DESC LIMIT 20"
  },
